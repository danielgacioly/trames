{
  "name": "trames",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @trames/db migrate",
    "db:seed": "pnpm --filter @trames/db seed && pnpm --filter @trames/worker miniaturas",
    "fila:instalar": "pnpm --filter @trames/worker fila:instalar",
    "preparar": "pnpm --filter @trames/db build && pnpm db:migrate && pnpm fila:instalar && pnpm --filter @trames/db storage && pnpm db:seed",
    "storage": "pnpm --filter @trames/db storage",
    "caixa": "pnpm --silent --filter @trames/db caixa"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.6.3"
  }
}
