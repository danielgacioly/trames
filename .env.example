# Copie para .env. Valores de desenvolvimento local.
NODE_ENV=development

# Papel dono (migrações e seed) e papel da aplicação (sem posse das tabelas: RLS vale sempre)
DATABASE_URL_DONO=postgresql://postgres:postgres@127.0.0.1:5432/trames
DATABASE_URL=postgresql://trames_app:trames_app@127.0.0.1:5432/trames

# KMS: em produção use KMS_KEY_ID (AWS KMS, sa-east-1). Em dev, uma chave local de 32 bytes em base64.
# KMS_KEY_ID=arn:aws:kms:sa-east-1:...
CHAVE_MESTRA_LOCAL=troque-por-openssl-rand-base64-32
# Chave do índice cego (HMAC) de CPF e telefone. Em produção, no Secrets Manager.
CHAVE_HMAC=troque-por-openssl-rand-base64-32

# Storage S3 (em dev: moto, do docker compose)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=teste
AWS_SECRET_ACCESS_KEY=teste-teste
S3_ENDPOINT=http://127.0.0.1:9000
S3_ENDPOINT_PUBLICO=http://localhost:9000
S3_BUCKET_QUARENTENA=trames-quarentena
S3_BUCKET_DOCUMENTOS=trames-documentos

# API
PORTA_API=3000
URL_WEB=http://localhost:5173
URL_BALCAO=http://localhost:5174

# Worker
CLAMD_HOST=127.0.0.1
CLAMD_PORTA=3310
# Envio de mensagens: "dev" grava na caixa de saída de desenvolvimento
MENSAGENS=dev
# WhatsApp Cloud API (Meta): a Trames só manda template aprovado.
# WHATSAPP_TOKEN=
# WHATSAPP_NUMERO_ID=
# WHATSAPP_TEMPLATE_CODIGO=trames_codigo
# WHATSAPP_TEMPLATE_LEMBRETE=trames_lembrete
# SES_REMETENTE=nao-responda@trames.app

# Turu fica fora do lançamento. Para ligar em desenvolvimento: TURU=1 (API) e VITE_TURU=1 (painel).
# TURU=1
# VITE_TURU=1
# Com chave, o Turu usa o Claude; sem chave, a montagem simples por palavras.
# ANTHROPIC_API_KEY=

# Planos: troca de plano sem cobrança (só em desenvolvimento)
COBRANCA_SIMULADA=1
