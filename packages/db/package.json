{
  "name": "@trames/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./armazenamento": "./src/armazenamento.ts",
    "./contas-teste": "./src/contas-teste.ts",
    "./modelos-padrao": "./src/modelos-padrao.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "typecheck": "prisma generate && tsc -p .",
    "migrate": "dotenv -e ../../.env -- sh -c 'DATABASE_URL=$DATABASE_URL_DONO prisma migrate deploy'",
    "migrate:dev": "dotenv -e ../../.env -- sh -c 'DATABASE_URL=$DATABASE_URL_DONO prisma migrate dev'",
    "seed": "dotenv -e ../../.env -- sh -c 'DATABASE_URL=$DATABASE_URL_DONO tsx src/seed.ts'",
    "storage": "dotenv -e ../../.env -- tsx src/preparar-storage.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@trames/shared": "workspace:*",
    "@aws-sdk/client-kms": "^3.716.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-presigned-post": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "argon2": "^0.41.1",
    "@types/node": "^22.10.2"
  }
}